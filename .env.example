# Backend API HTTP(S) origin only. Leave empty for same-origin /api/* routes.
# Example for split-origin deployments: https://api.example.com (no path/query/hash)
VITE_API_BASE_URL=

# Backend-generated Web Push VAPID public key. Required for real push subscriptions.
VITE_VAPID_PUBLIC_KEY=

# Local network dev-server access only. Production must be served by HTTPS backend/proxy.
VITE_DEV_SERVER_HOST=
