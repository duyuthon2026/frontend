# Production-local split-origin default. Leave empty only when the backend serves dist/ same-origin.
# API base must be an HTTP(S) origin with no path/query/hash.
# Matches ../DuYuTho_n PORT=3000 and CORS_ALLOWED_ORIGINS for localhost smoke tests.
VITE_API_BASE_URL=http://localhost:3000

# Optional Clerk publishable key. Leave empty to use the anonymous-household prototype flow.
VITE_CLERK_PUBLISHABLE_KEY=

# Local backend integration smoke tests only. Requires backend ALLOW_ANONYMOUS_HOUSEHOLD=true.
VITE_ALLOW_ANONYMOUS_BACKEND=

# Backend-generated Web Push VAPID public key. Safe to expose; required for real push subscriptions.
# `bun run env:local-production` in the backend writes this to .env.production.local automatically.
VITE_VAPID_PUBLIC_KEY=

# Local network dev-server access only. Production must be served by HTTPS backend/proxy.
VITE_DEV_SERVER_HOST=
